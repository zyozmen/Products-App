# Base del backend. Acepta "http://localhost:8080" o "/api" (se añade /api si falta). Las rutas de auth son /api/auth/*
VITE_API_URL=/api
# Minutos sin actividad (mouse, teclado, clic o scroll) tras los que se muestra el aviso de cierre (60 s para cancelar)
VITE_INACTIVITY_MINUTES=15
# Minutos desde la emision del token tras los que se renueva una sola vez (el token dura 60 min en el backend)
VITE_SESSION_REFRESH_MINUTES=55
VITE_APP_PRODUCTS_API_URL=http://127.0.0.1:8080/api/productos
VITE_APP_NAME=GrowShop
VITE_WHATSAPP_NUMBER=573124058166
