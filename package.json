{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@hookform/resolvers": "^5.9.2",
    "@react-navigation/native": "^7.2.5",
    "@tanstack/react-query": "^5.104.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "animate.css": "^4.1.1",
    "axios": "^1.17.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.17.0",
    "swiper": "^14.0.7",
    "web-vitals": "^2.1.4",
    "zod": "^4.6.7"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 4200",
    "dev": "vite --host 0.0.0.0 --port 4200",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down --remove-orphans",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage "
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.30",
    "sonarqube-scanner": "^4.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.js",
      "!src/reportWebVitals.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/assets/"
    ]
  }
}
